{
  "kind": "collectionType",
  "collectionName": "payments",
  "info": {
    "singularName": "payment",
    "pluralName": "payments",
    "displayName": "Payment"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "amount": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "dueDate": {
      "type": "date",
      "required": true
    },
    "paidDate": {
      "type": "date"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "cash",
        "card",
        "transfer"
      ],
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "paid",
        "pending",
        "overdue"
      ],
      "required": true
    },
    "smsSent": {
      "type": "boolean",
      "default": false
    },
    "guest": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::guest.guest",
      "inversedBy": "payments"
    }
  }
}
